# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=invoice_factoring
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Application DB role (restricted — no BYPASSRLS)
APP_DB_USER=app_worker
APP_DB_PASSWORD=change_me_worker_password

# ── Spring Boot ───────────────────────────────────────────────────────────────
# At least 64 random characters; generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_very_long_random_base64_encoded_secret_at_least_64_chars
JWT_EXPIRATION_MS=3600000

SPRING_PROFILES_ACTIVE=local

BACKEND_PORT=8080

# ── Angular ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080
